---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";

interface Tool {
	name: string;
	desc: string;
	url: string;
	icon: string;
	external?: boolean;
}

const tools: Tool[] = [
	{
		name: "SteamID 转换",
		desc: "STEAM_X:Y:Z、Steam3ID、Steam64 互相转换",
		url: "/tools/steamid/",
		icon: "fa7-brands:steam",
	},
	{
		name: "求生之路查服",
		desc: "求生之路网页/APP 服务器查询",
		url: "https://l.cn3.top/p/123",
		icon: "material-symbols:travel-explore",
		external: true,
	},
	{
		name: "增量更新工具",
		desc: "基于 hdiffz 的 GUI 增量更新小工具",
		url: "https://github.com/yinleren6/hdiffz_gui_tool",
		icon: "material-symbols:file-copy",
		external: true,
	},
];
---

<MainGridLayout title="小工具">
  <div class="card-base p-6">
    <h2 class="font-bold text-xl mb-6">🛠️ 小工具</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        tools.map((tool) => (
          <a
            href={tool.url}
            target={tool.external ? "_blank" : undefined}
            rel={tool.external ? "noopener noreferrer" : undefined}
            class="group flex flex-col gap-3 p-5 rounded-xl border border-(--border) bg-(--card-bg)
                   hover:border-(--primary) hover:shadow-sm
                   transition-all duration-200"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex items-center justify-center w-10 h-10 rounded-lg text-xl
                       bg-(--primary)/10 text-(--primary) group-hover:bg-(--primary) group-hover:text-white
                       transition-all duration-200"
              >
                <Icon is:inline name={tool.icon} />
              </div>
              <span class="font-bold text-lg text-(--text) group-hover:text-(--primary) transition-colors">
                {tool.name}
              </span>
              {tool.external && (
                <Icon is:inline name="material-symbols:open-in-new" class="text-sm text-(--content-meta) shrink-0" />
              )}
            </div>
            <p class="text-sm text-(--content-meta) leading-relaxed">
              {tool.desc}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</MainGridLayout>